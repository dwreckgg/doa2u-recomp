# Writes np_build_id.h for online play's build check (netplay_session.c): the
# git tree hash of this doa2u folder and whether tracked files under it differ
# from the commit. Any clean build of the same doa2u tree gets the same
# identity, whatever the history around it; a modified tree or a source copy
# without git falls back to the exe's link stamp (np_build_id).
# Run every build (cmake -P) with GIT, SRC and OUT set; OUT is rewritten only
# when its contents change, so nothing recompiles needlessly.
set(tree "")
set(dirty 1)
if(GIT)
    execute_process(COMMAND "${GIT}" rev-parse HEAD:doa2u
                    WORKING_DIRECTORY "${SRC}/.."
                    OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        set(tree "")
    endif()
    execute_process(COMMAND "${GIT}" status --porcelain --untracked-files=no -- .
                    WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE st RESULT_VARIABLE rc2 ERROR_QUIET)
    if(rc2 EQUAL 0 AND st STREQUAL "")
        set(dirty 0)
    endif()
endif()
set(text "/* generated by cmake/np_build_id.cmake */\n#define NP_BUILD_TREE \"${tree}\"\n#define NP_BUILD_DIRTY ${dirty}\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
